# 0xPDFForge — Environment Variables
# Copy to .env and fill. Never commit .env

# Security limits
MAX_ZIP_SIZE=52428800          # 50 MB
MAX_EXTRACTED_SIZE=314572800   # 300 MB
MAX_FILE_COUNT=10000
MAX_SINGLE_FILE=10485760       # 10 MB

# Optional AI enhancement (disabled by default — app works fully without it)
AI_DISABLED=true
# If you enable AI later:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Server
HOST=127.0.0.1
PORT=8000
